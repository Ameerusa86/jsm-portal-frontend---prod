# ==============================================================================
# EMSMC IT - Jira Service Management (JSM) Custom Portal
# PURE PRODUCTION CONFIGURATION ONLY
# ==============================================================================

# Atlassian Production JSM Instance URL
JIRA_BASE_URL=https://emsmc1.atlassian.net

# Jira Service Desk & Project Settings
JIRA_SERVICE_DESK_ID=1
JIRA_PROJECT_KEY=ITSD

# Optional: Atlassian Cloud ID for Forms (ProForma) API
# (If not provided, automatically resolved from Atlassian OAuth / accessible resources)
ATLASSIAN_CLOUD_ID=

# ------------------------------------------------------------------------------
# Auth.js / NextAuth Configuration (OAuth 2.0 3LO)
# ------------------------------------------------------------------------------
# Random secret for session encryption (generate via: openssl rand -base64 33 or npx auth secret)
AUTH_SECRET=
# Canonical URL of your app (e.g. http://localhost:3001 in dev or https://your-prod-domain.com)
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# Microsoft 365 / Entra ID (Azure AD) SSO Credentials
# Register in https://portal.azure.com -> Microsoft Entra ID -> App registrations
# Callback URL: https://{YOUR_DOMAIN}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Single-tenant issuer URL: https://login.microsoftonline.com/{TENANT_ID}/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Atlassian Production OAuth 2.0 (3LO) App Credentials
# Create in https://developer.atlassian.com/console/myapps/
# Uses "read:me offline_access" by default so unlicensed employees/customers
# can sign in without requiring a paid Jira, JSM Agent, or Confluence seat.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optional override if custom scopes are desired (defaults to "read:me offline_access")
ATLASSIAN_OAUTH_SCOPES=read:me offline_access

# ------------------------------------------------------------------------------
# Backend System Account (Basic Auth) for Jira, JSM & Confluence Knowledge Base
# ------------------------------------------------------------------------------
# Required so the backend can fetch service desks, request types, forms, KB articles,
# and raise/query tickets on behalf of unlicensed portal users.
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
